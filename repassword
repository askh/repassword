#!/usr/bin/env python3

import argparse
from dataclasses import dataclass
from datetime import datetime
from enum import Enum
import hashlib
import logging
import string

PROGRAM = 'repassword'
VERSION = '0.0.0'

DEFAULT_PASSWORD_LEN = 20
DEFAULT_REALM = 'login'

class CharsetId(Enum):
    ALPHA = 1
    ALPHANUM = 2
    EXTENDED = 3
    STRONG = 4

chars_alpha = string.ascii_uppercase + string.ascii_lowercase
chars_alphanum = chars_alpha + string.digits


CHARSETS = {
    CharsetId.ALPHA: list(chars_alpha),
    CharsetId.ALPHANUM: list(chars_alphanum),
    CharsetId.EXTENDED: list(chars_alphanum + '!#$%&*+,-./:;=?@^_'),
    CharsetId.STRONG: list(map(chr, list(range(33, 127))))
}

CHARSET_NAME_ID = {
    'alpha': CharsetId.ALPHA,
    'alphanum': CharsetId.ALPHANUM,
    'extended': CharsetId.EXTENDED,
    'strong': CharsetId.STRONG
}

CHARSET_ID_NAME = dict((v, k) for (k, v) in CHARSET_NAME_ID.items())


def show_version(args):
    print(f'{PROGRAM} version: {VERSION}.')


def list_charsets(args):
    for charset_id in CharsetId:
        print(CHARSET_ID_NAME[charset_id] + '\t' +
              "".join(CHARSETS[charset_id]))


def generate_hash(secret, year, number, host, user, realm):
    unique_str = secret + year + number + host + user + realm
    logging.debug(f'Unique string: {unique_str}')
    h = hashlib.sha3_512()
    h.update(unique_str.encode())
    digest = h.hexdigest()
    logging.debug(f'Unigue string digest: {digest}')
    return digest


def show_password(args):
    if args.read_secret:
        for i in range(3):
            secret = input('Secret: ')
            if not args.no_check_secret:
                secret1 = input('Retype secret: ')
                if secret != secret1:
                    logging.error('The secrets don\'t match.')
                    secret = None
                    continue
            break
        if secret is None:
            logging.error('Unknown secret.')
            return 2
    else:
        if args.secret is None:
            logging.error('Unknown secret.')
            return 2
        secret = args.secret

    logging.debug(f'Secret is {secret}.')

    hash_str = generate_hash(secret, str(args.year),
                             str(args.password_number),
                             args.host, args.user, args.realm)
    charset_name = args.charset
    charset_id = CHARSET_NAME_ID.get(charset_name)
    if charset_id is None:
        logging.error(f'Unknown charset: {charset_name}.')
        return 2

    charset = CHARSETS[charset_id]

    codes_int = int(hash_str, 16)
    password = ''
    charset_len = len(charset)
    chars_need = args.password_length

    while codes_int > 0 and chars_need > 0:
        char_idx = codes_int % charset_len
        password = charset[char_idx] + password
        codes_int = (codes_int - char_idx) // charset_len
        chars_need -= 1

    if len(password) < args.password_length:
        logging.error(f'Required password is too long.')
        return 2

    print(f'Password: {password}')

    return 0
    

def main():

    current_year = datetime.now().year
    
    arg_parser = argparse.ArgumentParser(prog=PROGRAM,
                                         description='Password generator',
                                         usage="""\

%(prog)s --show-password --host example.com --port 22 --realm ssh --user admin --secret SeCrEt --year 2026 --password-number 0 --charset alphanum

%(prog)s --show-password --host example.com --user manager --read-secret

echo -n SeCrEt | %(prog)s --show-password --host example.com --user manager --read-secret --no-check-secret""",
                                         epilog='Copyright: Alexander Kharitonov, 2026'
                                         )

    arg_parser.add_argument('-d', '--debug',
                            action='store_true', default=False,
                            help=argparse.SUPPRESS)

    arg_parser.add_argument('-s', '--secret', type=str,
                            help='Secret text')

    arg_parser.add_argument('-S', '--read-secret',
                            action='store_true',
                            help='Read secret from stdin')

    arg_parser.add_argument('-N', '--no-check-secret',
                            action='store_true',
                            help='Don\'t verify secret by asking for it twice' +
                            ' (with --read-secret option)')

    arg_parser.add_argument('-p', '--show-password',
                            action='store_true',
                            help='Show password')

    arg_parser.add_argument('-C', '--list-charsets',
                            action='store_true',
                            help='Show charsets')
    
    arg_parser.add_argument('-c', '--charset', type=str,
                            default=CHARSET_ID_NAME[CharsetId.STRONG],
                            help='Password number in year')

    arg_parser.add_argument('-l', '--password-length', type=int,
                            default=DEFAULT_PASSWORD_LEN,
                            help='Password length')

    arg_parser.add_argument('-y', '--year', type=int, default=current_year,
                            help='Year for password generation')

    arg_parser.add_argument('-n', '--password-number', type=int, default=0,
                            help='Password number in year')

    arg_parser.add_argument('-H', '--host', type=str,
                            help='Host for password')

    arg_parser.add_argument('-U', '--user', type=str,
                            help='User for password')

    arg_parser.add_argument('-r', '--realm', type=str,
                            default=DEFAULT_REALM,
                            help='Realm for password')

    arg_parser.add_argument('-v', '--version',
                            action='store_true',
                            help='Print version')

                          
    args = arg_parser.parse_args()

    if args.debug:
        logging.basicConfig(level=logging.DEBUG)

    if args.version:
        return show_version(args)
    elif args.show_password:
        return show_password(args)
    elif args.list_charsets:
        return list_charsets(args)
    
    return -1


if __name__ == '__main__':
  main()
